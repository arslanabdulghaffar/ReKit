# No .env file is loaded automatically. Set these process variables explicitly
# before using rekit.main:create_configured_app with Uvicorn --factory.
# The default rekit.main:app needs no configuration; workflow routes return 503.
REKIT_DATABASE_PATH=./var/rekit.sqlite3
REKIT_CATALOG_PATH=./tests/fixtures/synthetic_catalog.json
REKIT_DISPOSITION_POLICY_PATH=./tests/fixtures/synthetic_disposition_policy.json
REKIT_AUTH_CONFIG_PATH=./.secrets/operators.json
REKIT_EVIDENCE_DIR=./var/evidence

# Optional local GPU inspection. The default preserves manual inspection.
# Use one Uvicorn worker; never launch multiple model-owning API processes.
REKIT_INFERENCE_PROVIDER=disabled
REKIT_MODEL_DIR=./models/Qwen3-VL-2B-Instruct/89644892e4d85e24eaac8bacfd4f463576704203
REKIT_CUDA_DEVICE=1

# Reserved environment label; currently not read by the application.
REKIT_ENV=development

# Future AMD endpoint: explicitly select openai-remote only after qualification.
# Trusted backend settings only. No .env file is loaded automatically.
# The exact destination must also appear in the comma-separated allowlist.
# This .invalid hostname cannot target a real service.
REKIT_INFERENCE_BASE_URL=https://amd-inference.example.invalid/v1
REKIT_INFERENCE_ALLOWED_ENDPOINTS=https://amd-inference.example.invalid/v1/chat/completions
REKIT_INFERENCE_MODEL=
REKIT_INFERENCE_API_KEY=
# Actual immutable 40-character revisions from the deployment manifest.
# Configuration is not remote attestation; do not invent unknown revisions.
REKIT_INFERENCE_MODEL_REVISION=
REKIT_INFERENCE_PROCESSOR_REVISION=
REKIT_INFERENCE_MAX_IMAGES=2
REKIT_INFERENCE_TIMEOUT_SECONDS=120

# Optional future integration; disabled and unconfigured by default.
REKIT_EVOLUS_ENABLED=false
REKIT_EVOLUS_BASE_URL=
REKIT_EVOLUS_API_KEY=

# Keep actual secrets in ignored local configuration or a deployment secret store.
# Never put API keys in frontend VITE_* variables, logs, examples, or Git.
